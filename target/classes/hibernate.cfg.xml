<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Pengaturan Koneksi Database MySQL -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/minimart_db?createDatabaseIfNotExist=true&amp;useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=Asia/Jakarta</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password"></property>

        <!-- Dialect MySQL untuk Hibernate 6 -->
        <property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>

        <!-- Tampilkan SQL yang dieksekusi di console NetBeans -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Update tabel otomatis sesuai anotasi Entity -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Mapping Model Class (Entities) -->
        <mapping class="com.minimart.minimartgui.model.User"/>
        <mapping class="com.minimart.minimartgui.model.Product"/>
        <mapping class="com.minimart.minimartgui.model.Transaction"/>
        <mapping class="com.minimart.minimartgui.model.TransactionDetail"/>
    </session-factory>
</hibernate-configuration>
